# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GROQ_API_KEY: Optional key for Groq Cloud LPU high-performance models (Llama 3.3, etc.).
# Users can get a key from console.groq.com and configure it via the Secrets panel.
GROQ_API_KEY=""

# CMS publishing is disabled until both values are configured on the server.
# Use an HTTPS endpoint controlled by your organization. Never expose its token
# or allow the browser to supply the destination URL.
CMS_WEBHOOK_URL=""
# Exact hostname(s), comma-separated; must match the URL hostname.
CMS_WEBHOOK_ALLOWED_HOSTS=""
